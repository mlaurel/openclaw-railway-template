{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "publicOrigin": "${OPENCLAW_PUBLIC_ORIGIN}",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      },
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "tailscale": {
      "mode": "off"
    },
    "terminal": {
      "enabled": false
    },
    "nodes": {
      "pairing": {
        "sshVerify": false
      }
    }
  }
}
