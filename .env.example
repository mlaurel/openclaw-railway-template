# Runtime variables for the two Railway services. Full reference, including
# build-time settings and what lives on the volume: docs/CONFIGURATION.md.
#
# Nothing in this repository reads this file. On Railway, set each value as a
# service variable and seal the secrets. Locally, copy the "openclaw" block to
# .env and pass it with `docker run --env-file .env ...`.

# ── openclaw service ──────────────────────────────────────────────────────────

# Railway health-checks $PORT; it must equal the Gateway port (18789).
PORT=18789

# Required secret. Gateway authentication token, at least 32 characters.
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Secret. Key for the model provider you onboard with (docs/DEPLOYMENT.md step 4).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Secret, optional. Telegram bot token from @BotFather; enables the Telegram channel.
TELEGRAM_BOT_TOKEN=

# ── tailscale service ─────────────────────────────────────────────────────────

# Railway health-checks containerboot's /healthz on this port.
# PORT=9002

# Secret, optional. One-off, tagged auth key, used only for the first login.
# Leave unset to log in through the URL printed in the deploy logs instead.
# TS_AUTHKEY=

# Optional. MagicDNS name: https://<TS_HOSTNAME>.<tailnet>.ts.net
# TS_HOSTNAME=openclaw
